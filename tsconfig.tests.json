{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-build",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/simulation/pathfinding.ts",
    "src/simulation/trainMotion.ts",
    "src/simulation/passengerDemand.ts",
    "src/simulation/shiftPhases.ts",
